# Copie para .env (no mesmo diretório do main.py) e preencha.
# O .env NÃO é versionado. No Pi:  chmod 600 .env
#
# ── Telegram ─────────────────────────────────
# Token do bot gerado no BotFather
KILN_TELEGRAM_TOKEN=
# Chats que RECEBEM as mensagens, separados por vírgula.
#   Chat privado: seu id de usuário (número positivo)
#   Grupo: id do grupo (negativo, ex.: -1001234567890)
KILN_TELEGRAM_CHAT_IDS=
# Usuários que podem dar comandos (/status, /stop), separados por vírgula.
# Obrigatório quando as mensagens vão para um grupo; vazio = os chat ids acima.
KILN_TELEGRAM_ADMIN_IDS=
# Senha de confirmação do /stop
KILN_STOP_PASSWORD=
#
# ── Healthchecks.io (aviso se o Pi parar de dar sinal durante a queima) ──
# URL de ping do check, no formato https://hc-ping.com/<uuid>
KILN_HC_PING_URL=
# Chave de API read-write do projeto (Settings → API Access) — usada para pausar
# o check entre queimas. Sem ela o check não é pausado.
KILN_HC_API_KEY=
