# Serviço do controlador do forno — instalado por deploy/install.sh
# (@USER@, @DIR@, @PYTHON@ e @RELAYS_OFF@ são substituídos na instalação)

[Unit]
Description=Controlador do forno ceramico
# Não depende de rede: o forno precisa funcionar sem internet
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
# Os grupos gpio/spi/i2c/video do usuário (install.sh adiciona) dão acesso ao hardware
User=@USER@
WorkingDirectory=@DIR@
ExecStart=@PYTHON@ @DIR@/main.py
Environment=PYTHONUNBUFFERED=1

# Estado da queima em /var/lib/kiln-controller (retomada após reinício)
StateDirectory=kiln-controller
StateDirectoryMode=0700

# Registros das queimas (CSV + JSON) em /var/log/kiln-controller
LogsDirectory=kiln-controller
LogsDirectoryMode=0755

# Watchdog de software: se o loop principal parar de responder por 30 s,
# o systemd mata o processo e reinicia (a queima é retomada).
WatchdogSec=30
TimeoutStartSec=60
TimeoutStopSec=15
Restart=always
RestartSec=3

# Garante os relés DESLIGADOS sempre que o processo terminar, inclusive
# se ele for morto pelo watchdog (sem chance de rodar o finally do Python).
# Roda como root (+): usa a cópia de root instalada pelo install.sh, nunca o
# arquivo da pasta do projeto, que o usuário do serviço pode alterar.
ExecStopPost=+@RELAYS_OFF@

[Install]
WantedBy=multi-user.target
